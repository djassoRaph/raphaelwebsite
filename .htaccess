# Root .htaccess

RewriteEngine On

# www to non-www
RewriteCond %{HTTP_HOST} ^www\.raphaelreck\.com [NC]
RewriteRule ^(.*)$ https://raphaelreck.com/$1 [R=301,L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Redirect /index.html to /
RewriteCond %{THE_REQUEST} /index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect /blog/index.html to /blog/
RewriteCond %{THE_REQUEST} /blog/index\.html[\s?] [NC]
RewriteRule ^blog/index\.html$ /blog/ [R=301,L]

# Disable directory listing sitewide
Options -Indexes

# Redirect exposed folders with no index
RedirectMatch 301 ^/roots-time/?$ https://raphaelreck.com/roots-time/manifesto.html
RedirectMatch 301 ^/memes/?$ https://raphaelreck.com/fun.html
RedirectMatch 301 ^/scripts/?$ https://raphaelreck.com/

# SMB cluster consolidation — May 2026
# Four pages merged into monthly-support.html; 410 Gone signals
# intentional removal to Google rather than a temporary 404.
RewriteRule ^outsourced-it\.html$ - [G,L]
RewriteRule ^no-it-department\.html$ - [G,L]
RewriteRule ^smb-it-help\.html$ - [G,L]
RewriteRule ^no-contract-it\.html$ - [G,L]

# CV consolidation — Aug 2026
# /cv.html is now the canonical, indexable landing page (issue #92).
# Orphan/unlinked older CV PDF: redirect its indexed impressions to /cv.html.
RewriteRule ^public/raphael-reck\.pdf$ https://raphaelreck.com/cv.html [R=301,L]

# Keep PDFs out of search results — they carry no meta tags/internal links
# and only fragment ranking signals that /cv.html now consolidates.
<FilesMatch "\.pdf$">
  Header set X-Robots-Tag "noindex, nofollow"
</FilesMatch>

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# --- Caching freshness lifetimes ---
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
