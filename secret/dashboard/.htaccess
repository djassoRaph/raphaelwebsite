# secret/dashboard/.htaccess

# --- HTTP Basic Auth ---
# cPanel username is rera8347, docroot is /home/rera8347/raphaelreck.com/
# (not public_html on this host). EASIEST PATH: use cPanel's "Directory
# Privacy" GUI tool instead of hand-editing this block — it auto-generates a
# correctly-hashed .htpasswd outside the docroot AND writes its own
# AuthType/AuthName/AuthUserFile/Require block into this file. If you do
# that, DELETE this hand-written block rather than keeping both — two Basic
# Auth blocks in one .htaccess is undefined behavior.
AuthType Basic
AuthName "Raphael Reck — Private Dashboard"
AuthUserFile /home/rera8347/.htpasswds/secret/dashboard/passwd
Require valid-user

# --- Defense in depth: config.php must never be servable over HTTP, not even
# to an authenticated user — it should only ever be reached via api.php's
# internal require().
<FilesMatch "^config\.php$">
    Require all denied
</FilesMatch>

# Extra safety net in case the service-account JSON or any stray credential
# file is ever accidentally placed in this directory instead of outside the
# web root.
<FilesMatch "\.(json|pem|key|p12)$">
    Require all denied
</FilesMatch>

# Disable directory listing (matches root .htaccess's sitewide Options
# -Indexes; explicit here too since this directory holds nothing meant to be
# browsed).
Options -Indexes

# Never let a browser/proxy cache the dynamic API response — belt-and-suspenders
# alongside api.php's own Cache-Control: no-store header.
<FilesMatch "^api\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
</FilesMatch>
